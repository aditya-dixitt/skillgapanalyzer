# ─────────────────────────────────────────────────────────────────────────────
# Firebase (optional)
# Enables accounts, cross-device sync and campus analytics. Without these the
# app runs in local mode and stores data in the browser.
# These are public client identifiers (bundled into the app); access is
# enforced by firestore.rules.
# ─────────────────────────────────────────────────────────────────────────────
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# ─────────────────────────────────────────────────────────────────────────────
# AI roadmap personalisation (optional, SERVER-ONLY)
# Read by the /api server (Vite dev middleware or `npm start`). Never prefix
# these with VITE_ — that would ship the key to the browser.
# Without a key, roadmaps are produced by the deterministic planner only.
# ─────────────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_TIMEOUT_MS=60000

# Port for the standalone production server (`npm start`)
PORT=8080

# ─────────────────────────────────────────────────────────────────────────────
# Python code execution for the practical skill lab (optional, SERVER-ONLY)
# Python challenges run on a Judge0 instance (self-hosted or RapidAPI), never
# in the browser or this server. Without JUDGE0_URL, Python challenges are
# labelled "unavailable"; JavaScript, SQL, Git and HTML challenges still work.
# ─────────────────────────────────────────────────────────────────────────────
JUDGE0_URL=
JUDGE0_KEY=
# Header that carries the key. Self-hosted: X-Auth-Token. RapidAPI: X-RapidAPI-Key
JUDGE0_AUTH_HEADER=X-Auth-Token
# Judge0 language id for Python 3
JUDGE0_PYTHON_ID=71

# ─────────────────────────────────────────────────────────────────────────────
# Job-market insights (optional, SERVER-ONLY)
# Free keys from https://developer.adzuna.com. Without them the Market
# insights page shows a "not configured" state; it never invents data.
# ─────────────────────────────────────────────────────────────────────────────
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Two-letter Adzuna country code (in = India, gb, us, ...)
ADZUNA_COUNTRY=in
