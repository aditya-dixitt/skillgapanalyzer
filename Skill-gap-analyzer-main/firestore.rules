rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }
    function isAdmin() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Profile + career goal. Users can read/write their own data. Every
    // account starts as a student: the role can't be set to anything else on
    // create and can't be changed afterwards. Admins (placement cell) are
    // granted by editing users/{uid}.role in the Firebase console, which
    // bypasses these rules. Admins can read all profiles.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) &&
        request.resource.data.get('role', 'student') == 'student';
      allow update: if isOwner(userId) &&
        request.resource.data.get('role', null) == resource.data.get('role', null);
      allow delete: if isOwner(userId);
    }

    // Analysis snapshots — owners read/create/delete their own, admins read all
    // (campus analytics). Snapshots are immutable once written.
    match /skill_analysis/{analysisId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    // Active roadmap and progress — one document per user, private.
    match /roadmaps/{userId} {
      allow read, write: if isOwner(userId);
    }
    match /progress/{userId} {
      allow read, write: if isOwner(userId);
    }
    // Resume, job description and GitHub analyses — private to the owner.
    match /insights/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Industry roles are readable by all authenticated users
    match /industry_roles/{roleId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
  }
}
